MAIL_ADMIN_RECEIVER=
# Adresse de secours des alertes techniques (sauvegardes, erreurs, supervision).
ADMIN_ALERT_EMAIL=

MONITOR_BACKUP_MAX_AGE_HOURS=8
MONITOR_QUEUE_STALE_MINUTES=20
MONITOR_DISK_MAX_USAGE_PERCENT=85
MONITOR_ERROR_WINDOW_MINUTES=15
MONITOR_ERROR_THRESHOLD=3
MONITOR_ALERT_COOLDOWN_MINUTES=360

